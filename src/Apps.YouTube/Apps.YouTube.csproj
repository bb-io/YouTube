<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Product>Blackbird.YouTube.BrunoBitter.20261111</Product>
    <PackageId>Blackbird.YouTube.BrunoBitter.20261111</PackageId>
    <AssemblyName>Apps.YouTube.BrunoBitter.20261111</AssemblyName>
    <Description>Discover, publish and report on YouTube content with advanced polling, video uploads, playlists, analytics, metadata localization and captions.</Description>
    <Version>1.13.0</Version>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Blackbird.Applications.Sdk.Utils" Version="1.0.26" />
    <PackageReference Include="Blackbird.Applications.Sdk.Common" Version="2.17.0" />
    <PackageReference Include="Blackbird.Applications.SDK.Extensions.FileManagement" Version="1.1.0" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Apps.YouTube.Tests" />
    <InternalsVisibleTo Include="Tests.YouTube" />
    <EmbeddedResource Include="image/icon.png" CopyToOutputDirectory="Always" />
    <EmbeddedResource Include="../../README.md" Link="README.md" CopyToOutputDirectory="Always" />
  </ItemGroup>
</Project>
